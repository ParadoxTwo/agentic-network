# Copy to .env and fill in. Never commit the real .env (see .gitignore).
# Phase 0 only needs the Postgres credentials.

POSTGRES_USER=agentic
POSTGRES_DB=agentic
# The ONE place the password is defined. docker-compose uses it for the
# server; store/db.py builds DATABASE_URL from these same vars for the app.
# Set it to anything non-empty.
POSTGRES_PASSWORD=devpass

# Host ports. Change these if the defaults are already taken on your machine
# (e.g. a local Postgres already on 5432). Each one drives BOTH the
# docker-compose published port AND what the app connects to, so they stay in
# sync. The container's internal port is unaffected.
POSTGRES_PORT=5432
REDIS_PORT=6379

# --- Optional overrides ----------------------------------------------------
# Leave these unset for local dev. store/db.py composes the connection
# strings from the vars above by default. Set DATABASE_URL / REDIS_URL only to
# point at an external/managed service (they then take precedence).
#
# DATABASE_URL=postgresql://user:pass@host:5432/dbname
# REDIS_URL=redis://host:6379/0
# POSTGRES_HOST=127.0.0.1
# REDIS_HOST=127.0.0.1
