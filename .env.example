# Copy to .env and fill in. Never commit the real .env (see .gitignore).
# Phase 0 only needs the Postgres credentials; more vars land in later phases.

POSTGRES_USER=agentic
POSTGRES_DB=agentic
# Required — compose refuses to start Postgres without it.
POSTGRES_PASSWORD=

# Connection strings the store/ module reads (host-side / local dev).
DATABASE_URL=postgresql://agentic:CHANGE_ME@127.0.0.1:5432/agentic
REDIS_URL=redis://127.0.0.1:6379/0
