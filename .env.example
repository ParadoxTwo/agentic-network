# Copy to .env and fill in. Never commit the real .env (see .gitignore).
# Phase 0 only needs the Postgres credentials.

POSTGRES_USER=agentic
POSTGRES_DB=agentic
# The ONE place the password is defined. docker-compose uses it for the
# server; store/db.py builds DATABASE_URL from these same vars for the app.
# Set it to anything non-empty.
POSTGRES_PASSWORD=devpass

# --- Optional overrides ----------------------------------------------------
# Leave these unset for local dev. store/db.py composes the connection
# strings from the POSTGRES_* vars above by default. Set DATABASE_URL only to
# point at an external/managed database (it then takes precedence).
#
# DATABASE_URL=postgresql://user:pass@host:5432/dbname
# POSTGRES_HOST=127.0.0.1
# POSTGRES_PORT=5432
# REDIS_URL=redis://127.0.0.1:6379/0
